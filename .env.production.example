# Production environment variables — copy to `.env` next to docker-compose.prod.yml
# and fill in real values before running `docker compose -f docker-compose.prod.yml up -d --build`.
# `.env` is gitignored; never commit real secrets.

# --- Database ---
POSTGRES_DB=storefront
POSTGRES_USER=postgres
# Required. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- JWT auth ---
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=Storefront.Api
JWT_AUDIENCE=Storefront.Web

# --- First admin login ---
# Required. This becomes the only login for /admin on first boot.
# Password must satisfy: 8+ chars, upper+lower case, a digit, a symbol.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Public site ---
# The domain customers and the browser will use, proxied by nginx (no trailing slash).
# e.g. https://harunyapimarket.com — use http://localhost only for local testing.
PUBLIC_API_URL=http://localhost

# Keep false for the catalog + WhatsApp-only shop. Only set true if online
# checkout is actually wired up (payment provider configured, tested end to end).
ENABLE_ORDERING=false
